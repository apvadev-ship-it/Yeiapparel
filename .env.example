# ---------------------------------------------------------------------
# Copia este archivo como .env y rellena los valores reales.
# El .env NUNCA se sube al repositorio (ya esta en .gitignore).
#
# SECURITY_RULES Regla 8: aqui solo van claves de PRUEBA. Las claves de
# produccion (pub_prod_, prv_prod_, prod_integrity_, prod_events_) no se
# escriben nunca en este archivo: van en el gestor de secretos del
# despliegue. Ver PAGOKIT_PRODUCTION_CHECKLIST.md.
# ---------------------------------------------------------------------

# --- Wompi (pagos) ---------------------------------------------------
# Se obtienen en el panel de Wompi, en "Mi cuenta" > "Llaves" y
# "Secretos de integracion tecnica". El panel tiene dos juegos de
# llaves: sandbox (las de abajo) y produccion.

# Publica: puede verse, no pasa nada. Tambien define el entorno: si
# empieza por pub_test_ la app habla con sandbox.wompi.co, y si empieza
# por pub_prod_ habla con production.wompi.co.
WOMPI_PUBLIC_KEY=pub_test_XXXXXXXXXXXX

# SECRETA. Solo se usa para anular o devolver cobros con tarjeta desde
# el servidor. No hace falta para cobrar.
WOMPI_PRIVATE_KEY=prv_test_XXXXXXXXXXXX

# SECRETO. Firma el monto de cada cobro. Quien lo tenga puede cobrar a
# nombre de la tienda. Sin prefijo VITE_: ese prefijo incrusta el valor
# en el codigo publico que descarga el navegador.
WOMPI_INTEGRITY_SECRET=test_integrity_XXXXXXXXXXXX

# SECRETO. Valida que los eventos de pago vengan de Wompi. Sin esto,
# cualquiera podria avisar que un pedido "ya se pago".
# Regla 9: es un secreto DISTINTO al de integridad. No se intercambian:
# el webhook valida siempre con este, nunca con la llave publica ni con
# el secreto de integridad.
WOMPI_EVENTS_SECRET=test_events_XXXXXXXXXXXX

# A donde vuelve el comprador tras pagar (opcional).
WOMPI_REDIRECT_URL=https://tudominio.com/finalizar-compra

# En el panel de Wompi hay que registrar la URL de eventos:
#   https://tudominio.com/api/wompi/eventos

# SECRETO. Protege el endpoint interno de devoluciones
# (POST /api/wompi/reembolsos). Si esta vacio, ese endpoint queda
# apagado y responde 503. Genera uno largo y aleatorio, por ejemplo con
#   node -e "console.log(crypto.randomUUID()+crypto.randomUUID())"
WOMPI_ADMIN_TOKEN=

# --- Supabase --------------------------------------------------------
# Publicas: van al navegador (inventario, newsletter, contacto).
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# SECRETA. Solo servidor. Con ella se guardan los pedidos, los eventos
# ya procesados y las devoluciones, de modo que esas tablas quedan
# cerradas al navegador.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# --- Google Sheets (disponibilidad) ----------------------------------
# La disponibilidad de cada pieza se lee de una hoja de calculo de
# Google. Se edita desde el movil y la ficha se actualiza sola, sin
# desplegar nada. Si no se configura, la tienda usa el numero de
# respaldo que trae cada producto en src/lib/products.ts.
#
# La hoja debe tener una fila de cabecera y al menos estas columnas
# (los nombres no distinguen mayusculas ni tildes):
#
#   producto            | stock | disponible
#   Besties negro       | 6     | si
#   vestido-satin-eterno| 2     | si
#   Nala negro          | 0     | no
#
#   producto    -> nombre visible de la pieza O su slug. Tambien vale
#                  llamar a la columna slug, nombre, id o referencia.
#   stock       -> unidades. Tambien vale inventario, cantidad,
#                  unidades o existencias.
#   disponible  -> opcional. Solo sirve para apagar una pieza: "no",
#                  "agotado", "0" o "false" la dejan en Agotado aunque
#                  haya unidades. Tambien vale activo, estado o visible.
#
# Una fila cuyo producto no exista en el catalogo se ignora. Cuantas
# hay se ve en /api/disponibilidad (campo unknownCount) y CUALES son
# se escribe en el registro del servidor (la terminal en desarrollo,
# `wrangler tail` en produccion). Los nombres no salen en la respuesta
# a proposito: ese endpoint lo puede leer cualquiera, y en una hoja de
# inventario suele haber al lado notas que no son para publicar.
# Una fila sin numero y sin "no" tambien se ignora: una celda vacia no
# agota una pieza.

# El enlace de la hoja, pegado tal cual de la barra de direcciones, o
# solo el identificador. La hoja tiene que poder leerse sin sesion:
# Compartir > Acceso general > "Cualquier persona con el enlace" (Lector).
GOOGLE_SHEET_URL=

# Opcional: nombre de la pestana, si el inventario no esta en la
# primera. Ejemplo: Disponibilidad
GOOGLE_SHEET_NAME=

# Opcional: identificador numerico de la pestana (el gid= de la URL).
# Solo hace falta si el nombre lleva caracteres raros.
GOOGLE_SHEET_GID=

# Opcional. Clave de API de Google Cloud con la Sheets API habilitada.
# Sin ella se usa la exportacion publica en CSV, que basta. Con ella se
# usa la API v4, que es mas estable si la hoja es grande. Es un secreto:
# sin prefijo VITE_, para que no se incruste en el bundle del navegador.
GOOGLE_SHEETS_API_KEY=

# Opcional. Segundos que el servidor reutiliza una lectura antes de
# volver a preguntarle a Google. Por defecto 60. Subirlo baja el gasto,
# bajarlo hace que un cambio en la hoja se vea antes. El minimo es 5
# aunque se ponga menos: sin cache, cada visita a una ficha seria una
# llamada a Google, y la tienda se convertiria en un altavoz para
# generar ese trafico. El maximo es 3600.
GOOGLE_SHEET_CACHE_SECONDS=60

# --- Descuento automatico del inventario -----------------------------
# Cuando una compra queda PAGADA, la tienda le pide a la hoja que reste
# las unidades vendidas. La hoja es publica solo de LECTURA, asi que
# para escribir en ella hace falta un pequeno script publicado desde la
# propia hoja: google-apps-script/descontar-inventario.gs, con las
# instrucciones de instalacion dentro.
#
# El descuento ocurre solo con el pago confirmado (evento APPROVED de
# Wompi), nunca al iniciar la compra, y es idempotente por referencia de
# pedido: si el mismo pedido llegara dos veces, no resta dos veces.
#
# Si estas dos variables estan vacias, todo lo demas sigue funcionando:
# la tienda lee la hoja, pero el inventario se ajusta a mano.

# URL que da Google al implementar el script como aplicacion web.
# Termina en /exec. Solo se acepta si es https y del dominio
# script.google.com: aqui se manda que se vendio, y no puede acabar en
# un sitio cualquiera por una variable mal puesta.
GOOGLE_SHEET_WRITE_URL=

# SECRETO. El mismo valor tiene que estar en la variable TOKEN del
# script. Sin el, el script rechaza cualquier peticion. Viaja en el
# cuerpo de la peticion, nunca en la URL. Generalo con:
#   node -e "console.log((crypto.randomUUID()+crypto.randomUUID()).replace(/-/g,''))"
GOOGLE_SHEET_WRITE_TOKEN=

# --- Boletin: correo y agente de IA ----------------------------------
# La seccion del 15% guarda el correo en el servidor y manda el cupon.
# Las campanas de actualizacion de marca las escribe Claude y salen
# solas (envio automatico), asi que estas variables encienden un
# sistema que escribe a clientes reales. Tratalas como tales.

# SECRETA. Clave de Resend (empieza por re_). Se saca en
# resend.com > API Keys. Sin ella el alta funciona pero no sale correo:
# la persona queda registrada y se le avisa en pantalla.
RESEND_API_KEY=

# Remitente. DEJALO VACIO mientras no tengas dominio verificado: se usa
# el remitente de pruebas de Resend, que solo entrega a la direccion de
# tu propia cuenta. No es un limite del codigo, es de Resend.
#
# Para enviar a clientes de verdad: verifica el dominio en Resend
# (registros SPF y DKIM) y pon algo como:
#   EMAIL_FROM=YEI Apparel <hola@tudominio.com>
EMAIL_FROM=

# Direccion publica del sitio. En un correo los enlaces tienen que ser
# absolutos: sin esto, el boton y el enlace de baja apuntan a localhost.
SITE_URL=http://localhost:8080

# --- Aviso automatico de /contacto (Telegram y/o correo) --------------
# El formulario de contacto siempre guarda el mensaje en Supabase. Esto
# ademas manda un aviso al momento, sin que nadie tenga que confirmar
# nada (a diferencia del boton de WhatsApp del sitio, que abre un
# enlace wa.me y requiere que la persona le de "Enviar"). Los dos
# canales son independientes: pon uno, el otro, o los dos.
#
# Telegram (recomendado: gratis, se crea en un minuto, no toca el
# WhatsApp normal del negocio para nada):
#   1. En Telegram, abre una conversacion con @BotFather.
#   2. Mandale /newbot, dale un nombre y un usuario (debe terminar en
#      "bot", por ejemplo yei_apparel_bot).
#   3. Te responde con un token: eso es TELEGRAM_BOT_TOKEN.
#   4. Abre una conversacion con TU bot nuevo y mandale un mensaje
#      cualquiera (por ejemplo "hola"), para que sepa a quien contestar.
#   5. Visita en el navegador:
#      https://api.telegram.org/bot<TU_TOKEN>/getUpdates
#      Ahi aparece "chat":{"id": ...} - ese numero es TELEGRAM_CHAT_ID.
#
# SECRETO. Con este token cualquiera podria mandar mensajes como el bot.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Correo: usa la misma cuenta de Resend de arriba (RESEND_API_KEY).
# Mientras EMAIL_FROM este vacio (remitente de pruebas), Resend SOLO
# entrega a la direccion de tu propia cuenta - lo cual conviene aqui:
# es un aviso interno, no un correo a un cliente.
NOTIFY_EMAIL=

# SECRETA. Clave de la API de Anthropic (empieza por sk-ant-). Es la que
# usa el agente para redactar las campanas. Se saca en
# console.anthropic.com. Cada campana gasta una llamada al modelo.
ANTHROPIC_API_KEY=

# Opcional. Modelo del agente. Por defecto claude-opus-5.
ANTHROPIC_MODEL=claude-opus-5

# SECRETA. Token que protege /api/boletin/campana, el endpoint que
# dispara una campana. Sin este token el endpoint queda APAGADO, a
# proposito: una ruta que escribe a toda tu lista de clientes no puede
# quedar abierta por olvidar una variable.
#
# Generala con algo que no sea adivinable, por ejemplo:
#   node -e "console.log(crypto.randomUUID())"
NEWSLETTER_ADMIN_TOKEN=

# --- Feed real de Instagram y TikTok en el home ------------------------
# Procedimiento completo (cómo sacar cada valor, paso a paso) en
# SOCIAL_FEEDS_SETUP.md. Mientras estas variables estén vacías, el home
# sigue funcionando con publicaciones de ejemplo.

# SECRETO. Token de la Instagram Graph API (permiso instagram_basic),
# de una cuenta profesional (Business o Creator) vinculada a una
# página de Facebook. Se saca en developers.facebook.com.
INSTAGRAM_ACCESS_TOKEN=

# ID numérico de esa cuenta de Instagram profesional (no el @usuario).
INSTAGRAM_BUSINESS_ACCOUNT_ID=

# SECRETOS. Client key y client secret de la app de TikTok for
# Developers (developers.tiktok.com), con el producto "Login Kit" y el
# scope video.list habilitados.
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=

# SECRETO. Protege POST /api/social/sync, el endpoint que dispara la
# sincronización a mano. Sin este token el endpoint queda APAGADO.
# Generalo con:
#   node -e "console.log(crypto.randomUUID())"
SOCIAL_SYNC_ADMIN_TOKEN=

# --- Reporte semanal de ventas y tráfico ------------------------------
# Cada lunes a las 8:00 a. m. Colombia, el Worker manda a NOTIFY_EMAIL
# (definido arriba) un resumen de los pedidos de los últimos 7 días:
# cuántos se crearon, cuántos se pagaron, ingresos y el detalle de cada
# uno (cliente, correo, teléfono, ciudad). Ver src/lib/weekly-report.ts.
# No hace falta ninguna variable nueva para esto: reutiliza NOTIFY_EMAIL
# y RESEND_API_KEY. Si NOTIFY_EMAIL está vacío, este correo simplemente
# no sale.

# Publica. ID de medición de Google Analytics 4 (empieza por "G-"), del
# panel de GA4 en Administrador > Flujos de datos > tu flujo web. Sin
# esta variable no se carga ningún script de Google ni se manda tráfico
# a Analytics: el sitio funciona igual. Lleva prefijo VITE_ porque tiene
# que llegar al navegador (es lo normal para un ID de medición, no es
# secreto). Para recibir un resumen semanal de tráfico por correo,
# actívalo en GA4: Administrador > Personalización de informes >
# Programar informes, o Insights automáticos.
VITE_GA_MEASUREMENT_ID=
